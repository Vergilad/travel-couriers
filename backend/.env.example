# Copy to backend/.env and fill in. Never commit backend/.env.
# Laptop and server use the same file shape; only values differ.

# Postgres (used by backend directly, and by `psql $DATABASE_URL -f db/schema.sql`)
DATABASE_URL=postgresql://peregri:change-me@localhost:5432/peregri
# Password for the compose Postgres container (compose only)
POSTGRES_PASSWORD=change-me

# Auth: HS256 signing secret for access JWTs. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=change-me-to-32-random-bytes-minimum

# Handover codes carry receipt while deals are free. Yookassa arrives later
# (needs a Russian ИП); nothing payment related is configured yet.

# Browsers need CORS only when the frontend lives on its own domain.
# Same-origin (dev proxy, prod one-host routing) needs nothing here.
# Example: CORS_ORIGINS=https://viactor.net

# Manual verification is reviewed in-app at /admin (admin role only).
# Grant it with psql:
#   INSERT INTO user_roles (user_id, role) VALUES ('<user-uuid>', 'admin');
# No bot, no third party ever sees the documents.
